    {
        "name": "get_weather_forecast",
        "description": "किसी शहर के लिए 5-दिन के पूर्वानुमान में से किसी विशिष्ट तारीख/समय का मौसम प्राप्त करता है (Fetches forecasted weather for a specific date/time within the 5-day range)",
        "parameters": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "description": "शहर का नाम, जैसे 'Mumbai', 'Delhi', 'Jaipur'"
